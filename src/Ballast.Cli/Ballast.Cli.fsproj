<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>fsharp-ballast</ToolCommandName>
    <PackageId>fsharp-ballast</PackageId>
    <Version>0.1.0</Version>
    <Description>Measures Abstractness, Instability, Distance from the Main Sequence and effectfulness for F# and C# projects and solutions.</Description>
    <PackageTags>fsharp;csharp;metrics;architecture;coupling;static-analysis</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Authors>William Bergqvist</Authors>
    <Copyright>Copyright (c) 2026 William Bergqvist</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/shazmodan/fsharp-ballast</PackageProjectUrl>
    <RepositoryUrl>https://github.com/shazmodan/fsharp-ballast.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>First release. Options and report formats may still change before 1.0.</PackageReleaseNotes>
    <!-- Run on newer .NET runtimes than the one the tool was built for. -->
    <RollForward>Major</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Args.fs" />
    <Compile Include="Reports.fs" />
    <Compile Include="HtmlReport.fs" />
    <Compile Include="Cli.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Argu" />
    <!-- ExcludeAssets does not flow from Ballast.Analysis, so each executable repeats it. -->
    <PackageReference Include="Microsoft.Build.Framework" ExcludeAssets="runtime" />
    <ProjectReference Include="..\Ballast.Core\Ballast.Core.fsproj" />
    <ProjectReference Include="..\Ballast.Analysis\Ballast.Analysis.fsproj" />
  </ItemGroup>
</Project>
